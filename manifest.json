{
  "id": "pet-agent-status",
  "name": "Agent 会话状态",
  "version": "0.4.1",
  "apiVersion": 1,
  "activation": "opt-in",
  "kind": [
    "tool",
    "panel",
    "settings"
  ],
  "permissions": [
    "storage",
    "pet",
    "ui",
    "events",
    "scheduler"
  ],
  "entry": {
    "tool": "tool/index.js",
    "panel": {
      "src": "panel/panel.html",
      "title": "Agent 会话",
      "width": 320,
      "height": 420,
      "transparent": false
    },
    "settings": {
      "title": "Agent 会话状态",
      "fields": [
        {
          "key": "codexIpcEnabled",
          "type": "boolean",
          "default": false,
          "label": "Codex App 实时增强（实验）",
          "hint": "连接 Codex App 的内部接口以实时感知任务跟随状态。该接口未获官方稳定性承诺，出问题会自动退回默认的钩子通道。"
        }
      ]
    }
  }
}